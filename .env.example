# ------------------------------------------------------------------
# Mystic Egypt Tourism Platform - Environment Variables Template
# Copy this file to .env and fill in real values. NEVER commit .env.
# ------------------------------------------------------------------

# --- Database (MariaDB) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="mysql://mystic_user:CHANGE_ME@localhost:3306/mystic_egypt"

# --- NextAuth ---
# Base URL of the site (dev: http://localhost:3000, prod: https://mysticegypt.net)
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"

# --- Stripe (Payment Gateway) ---
# Stripe publishes a pk_ and sk_ key. Use test keys during development.
STRIPE_PUBLISHABLE_KEY="pk_test_CHANGE_ME"
STRIPE_SECRET_KEY="sk_test_CHANGE_ME"
# Webhook signing secret (whsec_) for /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_CHANGE_ME"

# --- Resend (Transactional Email) ---
RESEND_API_KEY="re_CHANGE_ME"
# Sender address (must match a verified domain in Resend)
APP_EMAIL_FROM="Mystic Egypt <noreply@mysticegypt.net>"

# --- Google Analytics 4 ---
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# Measurement Protocol API Secret (GA4 Admin → Data Streams → Configure
# tag settings → Measurement Protocol). Used only for the server-side
# purchase event sent from the Stripe webhook. Never exposed to the client.
GA_MEASUREMENT_SECRET="CHANGE_ME"

# --- Meta (Meta Pixel + Conversions API) ---
# Pixel id for the browser pixel (client-side, safe to expose).
NEXT_PUBLIC_META_PIXEL_ID="1510981584397229"
# Same pixel id, used by the server-side Conversions API.
META_PIXEL_ID="1510981584397229"
# Meta Business Manager → Settings → Data Sources → Conversions API →
# Generate access token. MUST stay server-only — never ship it to the client.
META_CAPI_TOKEN="EAA_CHANGE_ME"
# Optional: the test event code from Events Manager → Test Events, so CAPI
# deliveries land in the Test Events tool instead of production matching.
META_TEST_EVENT_CODE=""

# --- WhatsApp Click-to-Chat (international format, with +) ---
NEXT_PUBLIC_WHATSAPP_NUMBER="+44XXXXXXXXXX"

# --- Phone Numbers (international format, with +) ---
NEXT_PUBLIC_PHONE_UK="+44XXXXXXXXXX"
NEXT_PUBLIC_PHONE_EG="+20XXXXXXXXXX"
